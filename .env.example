# Copy this file to .env and fill in your provider credentials:
#     cp .env.example .env
#
# The CLI loads .env from the current working directory automatically.
# Variables already set in your shell take precedence over this file.
# Point PAPER2PERF_ENV_FILE at another file to load that instead.
# .env is git-ignored; never commit real API keys.

# ---------------------------------------------------------------------------
# Required: model provider
# ---------------------------------------------------------------------------
# Any OpenAI-compatible chat-completions endpoint that supports JSON-object
# responses and max_completion_tokens.
#
# OpenRouter example (DeepSeek V4.1 Flash, 2026-10-17 snapshot):
# PAPER2PERF_MODEL=deepseek/deepseek-v4.1-flash-1017
# PAPER2PERF_API_KEY=sk-or-v1-...
# PAPER2PERF_BASE_URL=https://openrouter.ai/api/v1
# PAPER2PERF_REASONING_EFFORT=none
# PAPER2PERF_MAX_COMPLETION_TOKENS=16000
PAPER2PERF_MODEL=
PAPER2PERF_API_KEY=
PAPER2PERF_BASE_URL=https://api.openai.com/v1

# Optional: load settings from a different environment file.
# PAPER2PERF_ENV_FILE=./.env

# ---------------------------------------------------------------------------
# Local state (documents, SQLite catalogs/checkpoints, runs/<id>/ artifacts)
# ---------------------------------------------------------------------------
PAPER2PERF_DATA_DIR=./data

# ---------------------------------------------------------------------------
# Run budgets. HTTP retries count toward the total model-call budget, including
# across a resume. Increase MAX_MODEL_CALLS deliberately, not to paper over a
# repeatedly failing request.
# ---------------------------------------------------------------------------
PAPER2PERF_MAX_MODEL_CALLS=12
PAPER2PERF_MAX_COMPLETION_TOKENS=6000

# ---------------------------------------------------------------------------
# Provider pacing and retry behavior
# ---------------------------------------------------------------------------
# Additional HTTP attempts per request (0-5).
PAPER2PERF_HTTP_RETRIES=3
# Initial exponential backoff in seconds.
PAPER2PERF_RETRY_BASE_SECONDS=2
# Longest automatic wait; a provider Retry-After above this stops with a resume
# instruction instead of being shortened.
PAPER2PERF_RETRY_MAX_WAIT_SECONDS=60
# Minimum spacing between request starts (useful for low rate limits).
PAPER2PERF_MODEL_MIN_INTERVAL_SECONDS=0

# ---------------------------------------------------------------------------
# Optional: reasoning controls. Leave empty to use the provider default.
# Allowed: none, minimal, low, medium, high, xhigh, max (model must support it).
# OpenRouter receives nested reasoning settings; direct OpenAI-compatible
# endpoints receive the top-level reasoning_effort field.
# ---------------------------------------------------------------------------
PAPER2PERF_REASONING_EFFORT=
